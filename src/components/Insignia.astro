---
/** Small heraldic shield for a place. Drawn inline so it stays crisp and themed. */
interface Props { kind: 'castle' | 'elk' | 'flame' | 'bough' | 'mine' | 'axe'; field: string; label: string; }
const { kind, field, label } = Astro.props;
const shield = 'M8 6 H92 V58 C92 88 72 104 50 115 C28 104 8 88 8 58 Z';
const inner = 'M14 12 H86 V58 C86 84 68 98 50 108 C32 98 14 84 14 58 Z';
---
<svg class="insignia" viewBox="0 0 100 120" role="img" aria-label={label}>
  <path d={shield} fill="#a87d2c" />
  <path d={inner} fill={field} stroke="#d8bb7a" stroke-width="1.2" />
  <g fill="#f2e6cb" stroke="#f2e6cb" stroke-linecap="round" stroke-linejoin="round">
    {kind === 'castle' && (
      <>
        <rect x="27" y="40" width="13" height="40" stroke="none" />
        <rect x="27" y="35" width="3.5" height="6" stroke="none" />
        <rect x="31.75" y="35" width="3.5" height="6" stroke="none" />
        <rect x="36.5" y="35" width="3.5" height="6" stroke="none" />
        <rect x="60" y="40" width="13" height="40" stroke="none" />
        <rect x="60" y="35" width="3.5" height="6" stroke="none" />
        <rect x="64.75" y="35" width="3.5" height="6" stroke="none" />
        <rect x="69.5" y="35" width="3.5" height="6" stroke="none" />
        <rect x="42" y="30" width="16" height="50" stroke="none" />
        <rect x="42" y="24" width="4" height="7" stroke="none" />
        <rect x="48" y="24" width="4" height="7" stroke="none" />
        <rect x="54" y="24" width="4" height="7" stroke="none" />
        <rect x="38" y="52" width="24" height="28" stroke="none" />
        <path d="M45 80 V68 a5 5 0 0 1 10 0 V80 Z" fill={field} stroke="none" />
        <path d="M32 87 q4.5 -4 9 0 t9 0 t9 0 t9 0" fill="none" stroke-width="2.6" />
        <path d="M38 94 q3 -3.5 6 0 t6 0 t6 0 t6 0" fill="none" stroke-width="2.6" />
      </>
    )}
    {kind === 'elk' && (
      <>
        <path d="M43 64 Q41 58 50 57 Q59 58 57 64 L54 84 Q50 92 46 84 Z" stroke="none" />
        <path d="M43 63 L35 59 L40 66 Z M57 63 L65 59 L60 66 Z" stroke="none" />
        <g fill="none" stroke-width="3.2">
          <path d="M46 58 C40 50 34 42 30 28" />
          <path d="M33 38 L22 34" /><path d="M31 32 L24 22" /><path d="M38 50 L28 50" />
          <path d="M54 58 C60 50 66 42 70 28" />
          <path d="M67 38 L78 34" /><path d="M69 32 L76 22" /><path d="M62 50 L72 50" />
        </g>
      </>
    )}
    {kind === 'flame' && (
      <>
        <path d="M50 24 C59 37 66 46 62 60 C60 68 54 73 50 73 C45 73 38 68 38 59 C38 51 45 48 45 39 C50 44 53 50 52 55 C57 48 56 36 50 24 Z" stroke="none" />
        <path d="M30 84 q5 -4 10 0 t10 0 t10 0 t10 0" fill="none" stroke-width="2.6" />
        <path d="M36 92 q3.5 -3.5 7 0 t7 0 t7 0 t7 0" fill="none" stroke-width="2.6" />
      </>
    )}
    {kind === 'bough' && (
      <g fill="none">
        <path d="M50 92 C48 80 52 70 50 58 C49 50 51 42 48 30" stroke-width="5.5" />
        <path d="M50 72 C44 66 38 62 32 50" stroke-width="3.4" /><path d="M38 61 L27 60" stroke-width="2.6" />
        <path d="M51 64 C58 58 63 52 68 40" stroke-width="3.4" /><path d="M63 52 L74 50" stroke-width="2.6" />
        <path d="M49 44 L40 36" stroke-width="2.6" /><path d="M32 50 L28 42" stroke-width="2.4" />
        <path d="M68 40 L66 31" stroke-width="2.4" />
        <path d="M50 92 L40 97 M50 92 L60 97 M50 92 L50 98" stroke-width="3" />
      </g>
    )}
    {kind === 'mine' && (
      <>
        <path d="M32 92 L68 42" fill="none" stroke-width="4" />
        <path d="M55 30 Q71 37 83 51" fill="none" stroke-width="6" />
        <path d="M68 92 L32 42" fill="none" stroke-width="4" />
        <path d="M22 47 L40 34" fill="none" stroke-width="10" stroke-linecap="butt" />
      </>
    )}
    {kind === 'axe' && (
      <>
        <path d="M48 26 V98" fill="none" stroke-width="4.5" />
        <path d="M50 38 C58 36 65 32 71 25 C81 40 81 62 71 79 C65 72 58 67 50 65 Z" stroke="none" />
        <path d="M46 46 L33 51 L46 57 Z" stroke="none" />
        <circle cx="48" cy="24" r="3.4" stroke="none" />
      </>
    )}
  </g>
</svg>
<style>
  .insignia { width: 3.4rem; height: auto; display: block; filter: drop-shadow(0 4px 6px rgb(43 30 20 / .25)); }
</style>
