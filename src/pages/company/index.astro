---
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import { company, orderNote } from '../../data/company';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="The Company" description="The five adventurers of the Silver-ranked company: Cocoa, Jack of Blades, Seamus, Valith Oakhaven, and Wonnelly Shadowleaf.">
  <section class="section">
    <div class="wrap">
      <div class="narrow intro">
        <h1>The Company</h1>
        <p class="order-note">{orderNote}</p>
        <p class="lede">The five have adventured together since their earliest days in the Guild, long enough to build the friendships, rivalries, habits, and trust expected of people who have survived danger together.</p>
        <p class="hint">Hover over a card, or tap it, to turn it over.</p>
      </div>
      <div class="roster">
        {company.map((h) => (
          <article class="hero-card" style={`--accent:${h.accent}`}>
            <div class="flip">
              <div class="flip-inner">
                <div class="face front">
                  <Art name={h.card} alt={`${h.name}'s character card`} sizes="(min-width: 60rem) 18rem, (min-width: 40rem) 45vw, 100vw" widths={[400, 700, 1000]} />
                </div>
                <div class="face back">
                  <p class="b-name">{h.name}</p>
                  <dl>
                    <dt>Lineage</dt><dd>{h.lineage}</dd>
                    <dt>Calling</dt><dd>{h.calling}</dd>
                    {h.carrying.length > 0 && <><dt>Carrying</dt><dd>{h.carrying.join('; ')}</dd></>}
                  </dl>
                  <p class="b-sum">{h.summary}</p>
                  <ul class="b-deeds">{h.deeds.slice(0, 3).map((d) => <li>{d}</li>)}</ul>
                  <a class="b-link" href={`${base}/company/${h.slug}/`}>Full page</a>
                </div>
              </div>
              <button class="flip-btn" type="button" aria-pressed="false" aria-label={`Turn over ${h.name}'s card`}></button>
            </div>
            <h2><a href={`${base}/company/${h.slug}/`}>{h.name}</a></h2>
            <span class="tag">{h.lineage}, {h.calling}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>The company, in plastic</h2>
      <div class="legos">
        {company.map((h) => (
          <figure>
            <Art name={h.lego} alt={`${h.name} as a Lego minifigure`} sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 100vw" widths={[400, 800, 1200]} />
            <figcaption>{h.name}</figcaption>
          </figure>
        ))}
        <figure>
          <Art name="lego-dm" alt="The Dungeon Master as a Lego minifigure holding a book" sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 100vw" widths={[400, 800, 1200]} />
          <figcaption>The DM</figcaption>
        </figure>
      </div>
    </div>
  </section>
  <script>
    document.querySelectorAll<HTMLButtonElement>('.flip-btn').forEach((b) =>
      b.addEventListener('click', () => {
        const turned = b.closest('.flip')!.classList.toggle('turned');
        b.setAttribute('aria-pressed', String(turned));
      }));
  </script>
</Base>

<style>
  .intro { margin-inline: 0; }
  .order-note { font-style: italic; color: var(--ink-soft); }
  .order-note + .lede { margin-top: 1.1rem; }
  .hint { margin-top: .8rem; font-size: 1rem; color: var(--crimson); }
  .roster { margin-top: 2.2rem; display: grid; gap: 1.4rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .hero-card h2 { font-size: 1.35rem; margin-top: 1rem; }
  .hero-card h2 a { color: inherit; text-decoration: none; }
  .hero-card h2 a:hover { color: var(--accent); }
  .hero-card .tag { display: block; font-style: italic; color: var(--ink-soft); font-size: 1rem; }
  .hero-card h2 + .tag { margin-top: .1em !important; }

  /* Flip, after the card flip in 21st.dev's Circular Flip Card Gallery */
  .flip { position: relative; perspective: 1400px; aspect-ratio: 2 / 3; }
  .flip-inner { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform .7s cubic-bezier(.3, 1.3, .5, 1); }
  .face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 22px; overflow: hidden; box-shadow: 0 16px 34px -18px rgb(43 30 20 / .7); }
  .front :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .back {
    transform: rotateY(180deg); background: var(--vellum); border: 2px solid var(--accent);
    padding: 1.3rem 1.3rem 1.1rem; display: flex; flex-direction: column; font-size: 1rem; line-height: 1.45;
    background-image: linear-gradient(var(--vellum), var(--vellum)), radial-gradient(circle at top, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%);
  }
  .b-name { font: 400 1.9rem/1 var(--display); color: var(--accent); }
  .back dl { margin: .9rem 0 0; display: grid; grid-template-columns: auto 1fr; gap: .25rem .8rem; }
  .back dt { font: 600 .72rem/1.9 var(--caps); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
  .back dd { margin: 0; }
  .b-sum { margin-top: .9rem; color: var(--ink-soft); font-style: italic; overflow: hidden; }
  .b-deeds { margin: .8rem 0 0; padding-left: 1.1rem; font-size: .95rem; }
  .b-deeds li + li { margin-top: .3rem; }
  .b-deeds li::marker { color: var(--accent); }
  .b-link { margin-top: auto; padding-top: .8rem; position: relative; z-index: 2; color: var(--accent); font: 600 .85rem var(--caps); letter-spacing: .08em; text-transform: uppercase; }
  .flip-btn { position: absolute; inset: 0; z-index: 1; border: 0; background: transparent; cursor: pointer; border-radius: 22px; }
  .flip-btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  .flip.turned .flip-inner { transform: rotateY(180deg); }
  .flip.turned .flip-btn { inset: 0 0 3.2rem 0; }
  @media (hover: hover) {
    .flip:hover .flip-inner { transform: rotateY(180deg); }
    .flip:hover .flip-btn { inset: 0 0 3.2rem 0; }
  }
  @media (prefers-reduced-motion: reduce) { .flip-inner { transition: none; } }
  .legos { margin-top: 1.4rem !important; display: grid; gap: 1.4rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .legos :global(img) { border-radius: var(--radius); }
</style>
