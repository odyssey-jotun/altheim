---
import Base from '../layouts/Base.astro';
import Entries from '../components/Entries.astro';
import { people } from '../data/world';
---
<Base title="People of Altheim" description="The Guild officials, shopkeepers, survivors, and rulers the company has met in Altheim.">
  <section class="section">
    <div class="wrap">
      <div class="narrow head">
        <h1>People of Altheim</h1>
        <p class="lede">Everyone the company has dealt with so far, from the Guild liaison who hands out their assignments to the king who has no heir.</p>
      </div>
      <Entries items={people} />
    </div>
  </section>
</Base>
<style>
  .head { margin: 0 0 2rem; }
</style>
