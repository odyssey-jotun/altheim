---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import { company } from '../data/company';
import { chapters } from '../data/chronicle';
import { questions } from '../data/world';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = chapters[chapters.length - 1];
---
<Base title="The Chronicle of Altheim" description="The story so far of a Silver-ranked company of the Adventurers' Guild in the kingdom of Altheim.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <span class="eyebrow">A campaign of the Adventurers' Guild</span>
        <h1>The Chronicle of Altheim</h1>
        <p class="lede">Five adventurers, newly raised to Silver Rank, in a kingdom held together by an old alliance, an aging king with no heir, and a warning carved beside a giant's axe.</p>
        <div class="btns">
          <a class="btn" href={`${base}/chronicle/`}>Read the story so far</a>
          <a class="btn ghost" href={`${base}/company/`}>Meet the company</a>
        </div>
      </div>
      <figure class="hero-art">
        <Art name="party-vs-goblins" alt="The five adventurers fighting goblins in a ruined hall" eager sizes="(min-width: 60rem) 38rem, 100vw" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">The company</span>
      <h2>Silver Rank, one assignment in</h2>
      <div class="grid party">
        {company.map((h) => (
          <a class="card" href={`${base}/company/${h.slug}/`}>
            <Art name={h.card} alt={`${h.name}'s character card`} sizes="(min-width: 72rem) 14rem, (min-width: 40rem) 45vw, 100vw" widths={[400, 700, 1000]} />
            <h3>{h.name}</h3>
            <span class="tag">{h.lineage}, {h.calling}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap latest">
      <figure>
        <Art name={latest.frontmatter.image ?? 'guild-hall'} alt={latest.frontmatter.alt ?? ''} sizes="(min-width: 60rem) 30rem, 100vw" />
      </figure>
      <div class="flow">
        <span class="eyebrow">Latest · {latest.frontmatter.numeral}</span>
        <h2>{latest.frontmatter.title}</h2>
        <p>The Silent Bell rings again. The goblin warren is broken, its prisoners are home, Jack has a bat's head for the wall and Seamus has a cape made of its wings. The Guild paid 600 gold for the company's first Silver assignment.</p>
        <p><a href={`${base}/chronicle/#${latest.slug}`}>Read the chapter</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap threads">
      <div class="flow">
        <span class="eyebrow">Unfinished business</span>
        <h2>Questions still open</h2>
        <ul class="qlist">
          {questions.map((q) => <li>{q}</li>)}
        </ul>
      </div>
      <a class="map-link" href={`${base}/kingdom/#map`}>
        <Art name="map-of-altheim" alt="Map of the Kingdom of Altheim" sizes="(min-width: 60rem) 34rem, 100vw" />
        <span>See the map of Altheim</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 4.5rem) 0; }
  .hero-grid { display: grid; gap: 2rem; align-items: center; }
  .hero-text > * + * { margin-top: 1.1rem; }
  .hero-text .btns { margin-top: 1.6rem; }
  .hero-art :global(img) { border-radius: 28px; box-shadow: 0 18px 40px -18px rgb(43 30 20 / .7); }
  @media (min-width: 60rem) { .hero-grid { grid-template-columns: 1fr 1.15fr; gap: 3rem; } }

  .party { margin-top: 1.4rem !important; grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr)); }
  .party .card { padding: .9rem; padding-bottom: 1rem; }
  .party .card > :global(picture) { margin: -.9rem -.9rem .8rem; }
  @media (max-width: 40rem) {
    .party { grid-template-columns: 1fr 1fr; gap: .9rem; }
    .party h3 { font-size: 1rem; }
    .party .tag { font-size: .9rem; }
  }

  .latest, .threads { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 60rem) {
    .latest { grid-template-columns: 1fr 1.2fr; gap: 3rem; }
    .threads { grid-template-columns: 1.1fr 1fr; gap: 3rem; }
  }
  .latest :global(img) { border-radius: var(--radius); }
  .qlist { padding-left: 1.2rem; }
  .qlist li + li { margin-top: .45em; }
  .qlist li::marker { color: var(--gold); }
  .map-link { display: block; color: var(--crimson); text-decoration: none; font: 600 .95rem var(--caps); letter-spacing: .06em; text-transform: uppercase; }
  .map-link :global(img) { border-radius: var(--radius); margin-bottom: .7rem; box-shadow: 0 10px 30px -14px rgb(43 30 20 / .55); }
  .map-link:hover span { text-decoration: underline; }
</style>
