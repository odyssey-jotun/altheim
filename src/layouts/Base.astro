---
import '../styles/global.css';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const nav = [
  ['/chronicle/', 'Chronicle'],
  ['/company/', 'The Company'],
  ['/kingdom/', 'The Kingdom'],
  ['/people/', 'People'],
  ['/bestiary/', 'Bestiary'],
  ['/gallery/', 'Gallery'],
];
const fullTitle = title === 'The Chronicle of Altheim' ? title : `${title} | The Chronicle of Altheim`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.png`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the story</a>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>Altheim</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map(([href, label]) => (
              <li><a href={base + href} aria-current={path.startsWith(base + href) ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-foot">
      <div class="wrap">
        <p class="motto">No Crown Stands Alone</p>
        <p>The Chronicle of Altheim, kept by the company of the Adventurers' Guild.</p>
      </div>
    </footer>
  </body>
</html>
